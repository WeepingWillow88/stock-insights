# Copy this file to ".env" and fill in your values, then restart the app / re-run the pipeline.
# The app auto-loads .env (it's gitignored, so your key stays local).

# --- Trading capital in £ (optional; defaults to 50000). Drives position sizing, the portfolio
#     heat cap, and the % deployed / cash-free tiles. Set the SAME value as a repo variable named
#     CAPITAL_GBP so the daily refresh Action sizes against the same number. ---
# CAPITAL_GBP=50000

# --- Claude news sentiment (enables the smart engine; get a key at console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Real economic calendar (optional; Financial Modeling Prep). Without it, a curated
#     fallback calendar is used. NOTE: FMP's economic-calendar endpoint requires a paid plan;
#     a free-tier key will fall back gracefully. ---
# FMP_API_KEY=your-fmp-key

# --- Richer stock news (optional; Finnhub company-news = headline + summary + source, reliably
#     tagged per ticker). Free tier works. Without it, news falls back to Google News RSS titles. ---
# FINNHUB_API_KEY=your-finnhub-key

# --- Email alerts (optional; if unset, digests are saved to data/alerts/) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# ALERT_FROM=you@example.com
# ALERT_TO=you@example.com
